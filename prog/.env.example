# AI工厂管家 · 社区版 —— 本地部署环境变量模板
# 复制本文件为 prog/.env（注意：.env 已加入 .gitignore，绝不会被提交）
#   Windows:  copy prog\.env.example prog\.env
#   Linux  :  cp prog/.env.example prog/.env

# ---- 数据库（必填，硬依赖：本仓库仅支持 PostgreSQL>=12，无 SQLite 降级）----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_factory
DB_USER=postgres
DB_PASSWORD=changeme

# ---- LLM 提供商（OpenAI 兼容接口：豆包 / DeepSeek 等）----
#   未配置时：意图识别走纯规则兜底，对话 LLM 生成能力不可用
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-flash-ga-260731
LLM_API_KEY=

# ---- Embedding（向量化，可选：未配置时知识库向量检索降级）----
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-large

# ---- MinIO / S3 兼容对象存储（可选：unavailable 时本地文件兜底）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- JWT 会话签名密钥（生产必需，请替换为 >=32 字节强随机值）----
#   生成示例:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- 基础认证种子账号（用于初始登录，生产请在首次登录后修改）----
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123

# ---- 社区版数据回传（默认关闭；开启需合规审计，脱敏后匿名上报）----
COMMUNITY_DB_ENABLED=false

# ---- 调试（生产请关闭）----
PROG_DEBUG=1