# =============================================================================
# AI工厂管家（AI Factory Manager）· 规则驱动的业务智能体 - 环境变量模板（社区版）
# 技术规格 v5.11
# 使用方法：cp .env.example .env，然后填入实际值
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
APP_SECRET_KEY=change-me-in-production
APP_ENV=development               # development / production
APP_PORT=5000
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# LLM 提供者（§1.8.2）
# 豆包/DeepSeek 等 OpenAI 兼容接口的 API Key
# -----------------------------------------------------------------------------
# 提供者标识：doubao / deepseek 等
LLM_PROVIDER=doubao
# API 地址与模型名（留空走代码内置默认）
LLM_BASE_URL=
LLM_MODEL=
# LLM 调用超时（秒，settings.py LLM_TIMEOUT）
LLM_TIMEOUT=60
# ARK_API_KEY：方舟 API Key 别名（LLM_API_KEY 未设置时回退）
ARK_API_KEY=
LLM_API_KEY=

# DeepSeek 备用（如需切换）
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 数据库 - 本地 PostgreSQL（§1.8.1）
# -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=ai_factory
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# 数据库 - 火山引擎 RDS（仅 volcano 模式使用）
# -----------------------------------------------------------------------------
RDS_HOST=
RDS_USER=
RDS_PASSWORD=

# -----------------------------------------------------------------------------
# 向量库 - 火山引擎 Milvus Cloud（仅 volcano 模式使用）
# -----------------------------------------------------------------------------
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_TOKEN=

# -----------------------------------------------------------------------------
# 文件存储 - 火山引擎 TOS（仅 volcano 模式使用）
# -----------------------------------------------------------------------------
TOS_ENDPOINT=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# S3 兼容凭据（file_storage 的 S3 路径）
S3_ACCESS_KEY=
S3_SECRET_KEY=

# MinIO 本地访问密钥（本地模式使用，可保持默认）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# 事件总线 / 缓存 - 火山引擎 Cloud Redis（仅 volcano 模式使用）
# -----------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 完整连接串（system_api/auth 直连检测用；留空走 redis://localhost:6379/0）
REDIS_URL=

# 本地 Redis（本地模式使用，默认无密码）
REDIS_LOCAL_PASSWORD=

# -----------------------------------------------------------------------------
# JWT 认证（§1.7）
# -----------------------------------------------------------------------------
# JWT_SECRET：api/auth.py 与 utils/crypto.py 使用的令牌签名密钥
JWT_SECRET=ai_factory_dev_secret
# JWT_SECRET_KEY：config/settings.py（Flask app.config）使用的签名密钥
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# access token 过期秒数（7200=2h）、refresh token 过期秒数（604800=7d）
JWT_EXPIRE_SECONDS=7200
JWT_REFRESH_EXPIRE_SECONDS=604800
# 续期阈值：access token 剩余有效期低于该值（秒）自动续期
JWT_RENEW_THRESHOLD=1800
JWT_EXPIRE_HOURS=24
# 敏感字段加密密钥（utils/crypto.py；留空时由 JWT_SECRET 派生）
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# SSO（S7 骨架）
# -----------------------------------------------------------------------------
SSO_OIDC_ISSUER=

# -----------------------------------------------------------------------------
# 知识库
# -----------------------------------------------------------------------------
# 知识文档上传目录（留空走默认 prog/uploads）
KB_UPLOAD_DIR=
# 联网检索开关（1/true 启用）
KB_WEB_SEARCH_ENABLED=0
# 知乎搜索 API 密钥（v7.04：联网搜索改用知乎，https://developer.zhihu.com/docs?key=zhihu_search）
# 配置后走知乎搜索（Authorization: Bearer <secret>），未配置回退 Bing（无需密钥）
ZHIHU_ACCESS_SECRET=
# 知乎搜索备份密钥（v7.06：主密钥 30001 频率限制超限时自动切换；支持逗号分隔多个）
ZHIHU_ACCESS_SECRET_BACKUP=

# -----------------------------------------------------------------------------
# 运行时
# -----------------------------------------------------------------------------
# 运行时调试开关（1 启用）
# ⚠️ 本地 dev 必须为 1：DEBUG 决定 api/auth.py _ensure_secure_secret 是否在登录入口
# 校验 JWT_SECRET 强度——为 0（非 DEBUG）时弱 JWT_SECRET（默认 ai_factory_dev_secret）
# 触发 fail-closed → 登录接口 500。生产部署设为 0 并配置 ≥32 字节强 JWT_SECRET。
RUNTIME_DEBUG=1
# 运行时日志文件路径（留空输出到控制台）
RUNTIME_LOG_FILE=
# 规则配置哈希盐（rules/config_manager.py 校验）
RULE_HASH_SALT=ai-factory-rule-hash-v6
# 数据库备份保留天数（scripts/backup_db.py，默认 30）
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Embedding 提供者（§1.8.6）
# 与 LLM_API_KEY 通常相同（豆包 Embedding）
# -----------------------------------------------------------------------------
EMBEDDING_API_KEY=

# =============================================================================
# 通知通道（S1）集中可配置参数（默认值=代码内置默认；email.py/webhook_channel.py
# 模块加载时读取，修改后需重启服务器生效）
# -----------------------------------------------------------------------------
# email（SMTP）：HOST 必填，未配置时邮件发送直接返回失败
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP 连接/命令超时（秒）
SMTP_TIMEOUT=10
# email 信号量限并发：单通道同时发送的最大数量
EMAIL_MAX_CONCURRENT=5
# email 重试：最大尝试次数（含首次）与指数退避基数（间隔=基数*2^(attempt-1)）
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE=1.0

# webhook：连接/读取超时（秒）
WEBHOOK_CONNECT_TIMEOUT=5
WEBHOOK_READ_TIMEOUT=10
# webhook 信号量限并发：单通道同时发送的最大数量
WEBHOOK_MAX_CONCURRENT=5
# webhook 重试：最大尝试次数（含首次）与指数退避基数；4xx 不重试
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE=1.0
# webhook HMAC-SHA256 签名密钥（留空则不加签）
WEBHOOK_HMAC_SECRET=
# webhook 事件分发（S8，core/webhook_dispatcher.py）：每次事件最大尝试次数/重试间隔（秒）/POST 超时（秒）
WEBHOOK_DISPATCH_MAX_ATTEMPTS=3
WEBHOOK_DISPATCH_RETRY_INTERVAL=1.0
WEBHOOK_DISPATCH_REQUEST_TIMEOUT=5

# =============================================================================
# 上传限制（字节，files_api / 图纸·工艺卡解析）
# -----------------------------------------------------------------------------
# 单文件上限（默认 20MB）、单次请求总量上限（默认 100MB）
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_TOTAL_BYTES=104857600
# 图纸/工艺卡解析文件上限（默认 50MB，drawing_parser / process_card_parser）
UPLOAD_MAX_DOC_BYTES=52428800

# =============================================================================
# 异步任务（S10）集中可配置参数
# -----------------------------------------------------------------------------
# 线程池最大并发数（Celery 不可用时的降级执行器）
ASYNC_MAX_WORKERS=4
# Celery broker 地址（已设置且已安装 celery 时异步任务走队列，否则降级线程池）
CELERY_BROKER_URL=

# =============================================================================
# API 并发（部署层）
# -----------------------------------------------------------------------------
# gunicorn worker 进程数（deploy-prod-linux.sh 读取系统环境变量 WORKERS；
# .env 中的值需 source 后生效；Dockerfile 默认 4）
WORKERS=4


#============================================================
#知乎搜索
#============================================================
ZHIHU_ACCESS_SECRET= 

# -----------------------------------------------------------------------------
# 社区版公共数据库采集（COMMUNITY，开源版数据回传）
# 用途：将训练样本/对话记录匿名上报至工厂托管公共库，用于通用能力优化。
# 默认关闭；开启需向工厂登记租户并获取 RDS 凭据。
# -----------------------------------------------------------------------------
COMMUNITY_DB_ENABLED=false
COMMUNITY_TENANT_ID=default
COMMUNITY_UPLOAD_INTERVAL=5   # 增量上报间隔（分钟，cron */N）
# 公共库连接（RDS_HOST/RDS_USER/RDS_PASSWORD 复用上方 RDS_* 项）
RDS_DATABASE=ai_factory_community

# =============================================================================
# 注意：
# 1. 本文件为模板，请勿提交真实密钥到版本库
# 2. _env 后缀的配置项在 deployment_config.json 中引用对应环境变量名
# 3. 环境变量优先级最高，覆盖 deployment_config.json 中的同名配置
# =============================================================================

